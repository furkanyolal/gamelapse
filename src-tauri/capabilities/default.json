{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "$APPDATA/com.furkanyolal.gametimetracker" },
        { "path": "$APPDATA/com.furkanyolal.gametimetracker/**" }
      ]
    },
    "notification:default",
    "store:default",
    "window-state:default"
  ]
}
