{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gamelapse",
  "version": "1.0.0",
  "identifier": "com.furkanyolal.gamelapse",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Gamelapse",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 500,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/covers/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Furkan YOLAL",
    "copyright": "Copyright (c) 2026 Furkan YOLAL",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "shortDescription": "Open source game time tracker for Windows",
    "longDescription": "Gamelapse tracks how long you play, keeps your library and play history on your own PC, and can import games from Steam and other launchers.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcwOEJFRjMyMDZBNTMxNTUKUldSVk1hVUdNdStMY0QvMkVEUDVxeGJseGtCUklDa3FnZ3VmR1hGWjg2R0RGWUtkdm85YU4rV04K",
      "endpoints": [
        "https://github.com/furkanyolal/gamelapse/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
